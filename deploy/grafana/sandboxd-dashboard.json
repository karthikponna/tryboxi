{
  "title": "sandboxd",
  "uid": "sandboxd",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running sandboxes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sandboxd_sandboxes"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warm pool VMs",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sandboxd_pool_vms"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Free memory budget (MB)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sandboxd_mem_free_mb"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Free vCPU budget",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sandboxd_vcpu_free"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Queue length",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sandboxd_queue_length"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Secrets blocked (1h)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(sandboxd_net_events_total{type=\"secret.blocked\"}[1h]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sandbox create latency by source (p50 / p95)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(sandboxd_create_seconds_bucket[5m])))",
          "legendFormat": "p50 {{source}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(sandboxd_create_seconds_bucket[5m])))",
          "legendFormat": "p95 {{source}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Phase duration p95 (traced spans)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(sandboxd_span_seconds_bucket{name!~\"HTTP.*\"}[5m])))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Executions by status (per min)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(sandboxd_executions_total[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Egress and secret events (per min)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(sandboxd_net_events_total[5m])) * 60",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Egress bandwidth",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "sum by (direction) (rate(sandboxd_net_bytes_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Phase errors (per min)",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(sandboxd_span_seconds_count{status=\"error\"}[5m])) * 60",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}